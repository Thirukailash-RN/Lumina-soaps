# Application Configuration
NODE_ENV="production"
PORT=3000
APP_URL="https://your-lumina-app.onrender.com"

# Supabase PostgreSQL & Auth & Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Initial Store Owner Setup (Thiru Kailash)
INITIAL_ADMIN_EMAIL="mailmethirukailash@gmail.com"
INITIAL_ADMIN_PASSWORD="OwnerPassword@2026"

# Razorpay Online Payment Gateway (Required for Live Online UPI / Cards)
# Leave blank to restrict store to Cash On Delivery (COD) until credentials configured
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Nodemailer SMTP Configuration for Order & Dispatch Emails
# Optional: system logs email events and continues safely if unconfigured
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Lumina Soaps <orders@luminasoaps.com>"
SMTP_SECURE="false"

# Gemini AI (Optional Studio integration)
GEMINI_API_KEY=""
